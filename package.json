    "format:check": "prettier --check .",
    "verify:live": "node scripts/smoke-gateway.js --live",
    "desktop": "node scripts/desktop.js",
    "test:desktop": "node scripts/desktop.js --smoke-test",
    "build:desktop": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=22.13.0"
  },
